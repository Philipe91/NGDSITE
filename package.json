{
  "name": "ngdsite",
  "version": "1.0.0",
  "description": "Build local de Tailwind CSS pra evitar uso do CDN em produção",
  "scripts": {
    "build:css": "tailwindcss -i ./static/src/tailwind-input.css -o ./static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./static/src/tailwind-input.css -o ./static/css/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0"
  }
}
