# Nao enviar para o Cloud Build. Sem isso o upload sobe 1,1 GB
# (venv 808M + media 148M + .git 97M) em vez de alguns MB.

.git/
.gitignore
venv/
.venv/
__pycache__/
*.py[cod]

# As imagens vivem no Supabase Storage, nao no container.
media/

# Segredos: as variaveis vao pelo --env-vars-file, nunca na imagem.
.env
.env.*

